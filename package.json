{
  "name": "dts-calc",
  "description": "DTS-Calc: distance, time and speed calculator for runners. Next 16, React 18, offline-first.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead",
    "not IE 11"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/write-sw-precache.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app/ components/ hooks/ lib/",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:e2e:offline": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "^6.0.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "playwright": "^1.58.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "^4.1.12"
  }
}
